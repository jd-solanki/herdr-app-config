{
  "name": "herdr-app-config",
  "version": "0.0.0",
  "private": true,
  "description": "Herdr app customizations: mods, layouts and their install",
  "homepage": "https://github.com/jd-solanki/herdr-app-config#readme",
  "license": "MIT",
  "author": "jd-solanki",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jd-solanki/herdr-app-config.git"
  },
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && vp pack",
    "dev": "rm -rf dist && (node --watch-path=apps --watch-preserve-output scripts/install-on-save.mjs & vp pack --watch --on-success 'sh scripts/install.sh'; wait)",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp config",
    "setup": "pnpm run build && sh scripts/install.sh",
    "types": "cp \"${HERDR_APP_HOME:-$HOME/.config/herdr-app}\"/gpui-kit.d.ts \"${HERDR_APP_HOME:-$HOME/.config/herdr-app}\"/herdr.d.ts types/"
  },
  "devDependencies": {
    "@herdr-app-config/github-search": "workspace:*",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  }
}
